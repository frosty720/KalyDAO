# KalyDAO frontend — copy to .env. Every variable the app reads is listed here.
# ONE chain: KalyChain 3890 (native KMT, governance token gKMT). No network switch.

# Supabase (anon key only — NEVER put the service-role key in a VITE_* variable, Vite ships
# every VITE_* value to the browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# thirdweb client id — same value as KalySwap / kaly-vault so users share ONE wallet
VITE_THIRDWEB_CLIENT_ID=

# Hostnames say "testnet" until DNS cuts over. CUT DAY: set these two and rebuild.
VITE_RPC_URL=https://mainrpc.kalychain.io/rpc
VITE_EXPLORER_URL=https://testnet.kalyscan.io

# Subgraphs on the kalyswap graph-node (chain `kmt`). Leave unset for the defaults;
# set VITE_DAO_SUBGRAPH_URL to an empty string to force on-chain fallback.
VITE_DAO_SUBGRAPH_URL=https://app.kalyswap.io/subgraphs/name/dao-subgraph-kmt
VITE_V3_SUBGRAPH_URL=https://app.kalyswap.io/subgraphs/name/v3-subgraph-kmt

# Optional: tempo storybook routes in dev
VITE_TEMPO=false
